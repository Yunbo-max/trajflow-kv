       ),
       simulator=config_classes.EmulatorConfig(
           emulator_launcher=emulator_launcher,
-          adb_controller=config_classes.AdbControllerConfig(adb_path=adb_path),
+          # Software-emulated Android can require several minutes to install
+          # the accessibility forwarder. The upstream 120s default is tuned
+          # for KVM and causes a false timeout in nested containers.
+          adb_controller=config_classes.AdbControllerConfig(
+              adb_path=adb_path, default_timeout=600.0
+          ),
       ),
   )
   android_env_instance = loader.load(config)
   logging.info('Setting up AndroidWorldController.')
-  return AndroidWorldController(android_env_instance)
+  # The forwarder performs several synchronous APK/broadcast operations that
+  # are prohibitively slow under TCG software emulation. Screenshot-only VLM
+  # rollouts do not consume the accessibility tree, so allow an explicit local
+  # fallback while retaining the upstream default for normal KVM runs.
+  a11y_method = A11yMethod(
+      os.environ.get('ANDROID_WORLD_A11Y_METHOD', A11yMethod.A11Y_FORWARDER_APP.value)
+  )
+  return AndroidWorldController(android_env_instance, a11y_method=a11y_method)
